{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "AOBench",

  // A one-click contributor environment: open in GitHub Codespaces or VS Code Dev
  // Containers and you get a working checkout with the corpus validated, without
  // installing Python, uv, or anything else locally. The whole benchmark runs
  // offline against frozen snapshots, so no cluster and no API key are needed.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "postCreateCommand": "pip install --user uv && uv sync --all-extras && uv run aobench doctor",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      }
    }
  },

  "forwardPorts": [8000, 3000],
  "portsAttributes": {
    "8000": { "label": "AOBench REST API / docs preview" },
    "3000": { "label": "Langfuse" }
  },

  "remoteEnv": {
    // Keep the held-out split held out by default, even here.
    "AOBENCH_UNLOCK_TEST": ""
  },

  "postAttachCommand": {
    "welcome": "echo '\\nAOBench dev container ready.\\n  aobench quickstart   — run your first scored task (no API key)\\n  make check           — lint + typecheck + drift checks + tests\\n  make docs-serve      — docs at http://localhost:8000\\n'"
  }
}
